<?xml version="1.0" encoding="utf-8"?>
<resources>
    <dimen name="home_metric_icon">20dp</dimen>
    <dimen name="home_metric_min_height">120dp</dimen>
    <dimen name="home_action_min_height">72dp</dimen>
    <dimen name="reporting_pill_height">36dp</dimen>
    <color name="home_action_pink_border">@color/action_primary</color>
    <color name="home_action_green_border">@color/dragon_green</color>

    <!-- Scoped styles: do not change shared Records, Analytics metric, or dialog styles. -->
    <style name="HomeMetricCard" parent="DashboardMetricCard">
        <item name="android:layout_width">172dp</item>
        <item name="android:layout_height">132dp</item>
        <item name="android:background">@drawable/home_metric_background</item>
        <item name="android:padding">@dimen/card_padding</item>
        <item name="android:elevation">0dp</item>
    </style>
    <style name="HomeMetricFigure" parent="DashboardMetricFigure">
        <item name="android:textSize">24sp</item>
        <item name="android:fontFamily">@font/manrope_500</item>
        <item name="android:textStyle">normal</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:textColor">@color/ink</item>
        <item name="android:maxLines">2</item>
        <item name="android:breakStrategy">simple</item>
    </style>
    <style name="HomeMetricLabel" parent="DashboardMetricLabel">
        <item name="android:fontFamily">@font/manrope</item>
        <item name="android:maxLines">2</item>
        <item name="android:layout_marginTop">@dimen/space_xs</item>
    </style>
    <style name="Widget.DragonView.HomeQuickAction" parent="Widget.Material3.Button.OutlinedButton">
        <item name="shapeAppearance">@style/ShapeAppearance.DragonView.Medium</item>
        <item name="android:minHeight">@dimen/home_action_min_height</item>
        <item name="android:minWidth">@dimen/touch_target</item>
        <item name="android:padding">@dimen/space_md</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:fontFamily">@font/manrope_500</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:textColor">@color/ink</item>
        <item name="iconTint">@color/dragon_magenta_dark</item>
        <item name="backgroundTint">@color/white</item>
        <item name="strokeColor">@color/neo_highlight</item>
        <item name="strokeWidth">1dp</item>
        <item name="iconSize">24dp</item>
        <item name="iconPadding">@dimen/space_sm</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:elevation">0dp</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="rippleColor">@color/focus_ripple</item>
    </style>
    <style name="Widget.DragonView.HomeQuickAction.Green" parent="Widget.DragonView.HomeQuickAction">
        <item name="android:textColor">@color/ink</item>
        <item name="backgroundTint">@color/white</item>
        <item name="strokeColor">@color/neo_highlight</item>
    </style>
    <!-- Home-only emphasis: the other modules keep their existing action styles. -->
    <style name="Widget.DragonView.HomeQuickAction.Primary" parent="Widget.DragonView.HomeQuickAction">
        <item name="backgroundTint">@color/dragon_magenta_dark</item>
        <item name="strokeWidth">0dp</item>
        <item name="android:textColor">@color/white</item>
        <item name="iconTint">@color/white</item>
        <item name="iconSize">20dp</item>
        <item name="android:padding">8dp</item>
    </style>
    <style name="Widget.DragonView.HomeQuickAction.PrimaryGreen" parent="Widget.DragonView.HomeQuickAction.Primary">
        <item name="backgroundTint">@color/dragon_green</item>
    </style>
    <style name="Widget.DragonView.HomeQuickAction.SoftPink" parent="Widget.DragonView.HomeQuickAction.Primary">
        <item name="backgroundTint">@color/dragon_pink_soft</item>
        <item name="strokeColor">@color/neo_highlight</item>
        <item name="strokeWidth">1dp</item>
        <item name="android:textColor">@color/ink</item>
        <item name="iconTint">@color/dragon_magenta_dark</item>
    </style>
    <style name="Widget.DragonView.HomeQuickAction.SoftGreen" parent="Widget.DragonView.HomeQuickAction.SoftPink">
        <item name="backgroundTint">@color/dragon_green_soft</item>
        <item name="iconTint">@color/dragon_green</item>
    </style>
    <style name="Widget.DragonView.ModuleAction.Primary" parent="Widget.DragonView.HomeQuickAction.Primary">
        <item name="android:minHeight">76dp</item>
    </style>
    <style name="Widget.DragonView.ModuleAction.Secondary" parent="Widget.DragonView.HomeQuickAction.SoftGreen">
        <item name="android:minHeight">76dp</item>
    </style>
    <style name="Widget.DragonView.BotanicalAction" parent="Widget.Material3.Button.OutlinedButton">
        <item name="shapeAppearance">@style/ShapeAppearance.DragonView.Small</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:fontFamily">@font/manrope_500</item>
        <item name="android:textColor">@color/botanical_accent</item>
        <item name="backgroundTint">@color/white</item>
        <item name="strokeColor">@color/botanical_accent</item>
        <item name="strokeWidth">1dp</item>
        <item name="iconTint">@color/botanical_accent</item>
        <item name="iconSize">18dp</item>
        <item name="iconPadding">5dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
    </style>

    <style name="HomeSummaryCard" parent="DashboardMetricCard">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:minHeight">132dp</item>
        <item name="android:layout_weight">1</item>
        <item name="android:background">@drawable/home_metric_background</item>
        <item name="android:padding">16dp</item>
    </style>

    <style name="HomeSummaryContext" parent="TextAppearance.Material3.BodySmall">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">4dp</item>
        <item name="android:textColor">@color/muted_ink</item>
        <item name="android:textSize">12sp</item>
    </style>
    <style name="Widget.DragonView.ReportingPeriod" parent="Widget.Material3.Chip.Filter">
        <item name="android:checkable">true</item>
        <item name="android:minHeight">@dimen/touch_target</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textColor">@color/period_button_text</item>
        <item name="chipBackgroundColor">@color/period_button_background</item>
        <item name="rippleColor">@color/focus_ripple</item>
        <item name="chipStrokeColor">@color/reporting_pill_border</item>
        <item name="chipStrokeWidth">1dp</item>
        <item name="chipMinHeight">@dimen/reporting_pill_height</item>
        <item name="shapeAppearance">@style/ShapeAppearance.DragonView.Pill</item>
        <item name="ensureMinTouchTargetSize">true</item>
        <item name="chipMinTouchTargetSize">@dimen/touch_target</item>
        <item name="checkedIconVisible">false</item>
        <item name="chipStartPadding">@dimen/space_sm</item>
        <item name="chipEndPadding">@dimen/space_sm</item>
        <item name="android:elevation">0dp</item>
        <item name="android:stateListAnimator">@null</item>
    </style>
    <style name="ShapeAppearance.DragonView.Pill" parent="ShapeAppearance.Material3.Corner.Full">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">50%</item>
    </style>
</resources>
