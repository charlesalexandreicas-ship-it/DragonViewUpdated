<resources>
    <style name="Theme.DragonView.Base" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/dragon_magenta</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorPrimaryContainer">@color/dragon_surface_variant</item>
        <item name="colorOnPrimaryContainer">@color/dragon_magenta_dark</item>
        <item name="colorSecondary">@color/dragon_green</item>
        <item name="colorOnSecondary">@color/white</item>
        <item name="colorSecondaryContainer">@color/dragon_green_soft</item>
        <item name="colorOnSecondaryContainer">@color/black</item>
        <item name="colorTertiary">@color/plum_orchid_400</item>
        <item name="colorSurface">@color/dragon_surface</item>
        <item name="colorSurfaceContainer">@color/white</item>
        <item name="colorOnSurface">@color/black</item>
        <item name="colorOutline">@color/dragon_outline</item>
        <item name="colorError">@color/dragon_error</item>
        <item name="android:fontFamily">sans-serif</item>
        <item name="fontFamily">sans-serif</item>
        <item name="materialButtonStyle">@style/Widget.DragonView.Button</item>
        <item name="materialCardViewStyle">@style/Widget.DragonView.Card</item>
        <item name="textInputStyle">@style/Widget.DragonView.TextInputLayout</item>
        <item name="shapeAppearanceSmallComponent">@style/ShapeAppearance.DragonView.Small</item>
        <item name="shapeAppearanceMediumComponent">@style/ShapeAppearance.DragonView.Medium</item>
        <item name="shapeAppearanceLargeComponent">@style/ShapeAppearance.DragonView.Large</item>
        <item name="textAppearanceHeadlineSmall">@style/TextAppearance.DragonView.HeadlineSmall</item>
        <item name="textAppearanceTitleLarge">@style/TextAppearance.DragonView.TitleLarge</item>
        <item name="textAppearanceTitleMedium">@style/TextAppearance.DragonView.TitleMedium</item>
        <item name="textAppearanceBodyLarge">@style/TextAppearance.DragonView.BodyLarge</item>
        <item name="textAppearanceBodyMedium">@style/TextAppearance.DragonView.BodyMedium</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:statusBarColor">@color/dragon_magenta</item>
        <item name="android:navigationBarColor">@color/white</item>
        <item name="android:colorAccent">@color/dragon_magenta</item>
        <item name="android:windowBackground">@color/warm_ivory</item>
    </style>

    <style name="Theme.DragonView" parent="Theme.DragonView.Base" />

    <style name="ShapeAppearance.DragonView.Small" parent="ShapeAppearance.Material3.Corner.Small">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">12dp</item>
    </style>
    <style name="ShapeAppearance.DragonView.Medium" parent="ShapeAppearance.Material3.Corner.Medium">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">16dp</item>
    </style>
    <style name="ShapeAppearance.DragonView.Large" parent="ShapeAppearance.Material3.Corner.Large">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">20dp</item>
    </style>

    <style name="Widget.DragonView.Button" parent="Widget.Material3.Button">
        <item name="shapeAppearance">@style/ShapeAppearance.DragonView.Small</item>
        <item name="android:minHeight">@dimen/button_height</item>
        <item name="android:minWidth">@dimen/touch_target</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">16dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textSize">14sp</item>
        <item name="android:letterSpacing">0.01</item>
        <item name="iconPadding">8dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="backgroundTint">@color/button_primary_background</item>
        <item name="android:textColor">@color/button_primary_text</item>
        <item name="rippleColor">@color/plum_orchid_400</item>
    </style>
    <style name="Widget.DragonView.Button.Outlined" parent="Widget.Material3.Button.OutlinedButton">
        <item name="shapeAppearance">@style/ShapeAppearance.DragonView.Small</item>
        <item name="android:minHeight">@dimen/button_height</item>
        <item name="android:minWidth">@dimen/touch_target</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">16dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textSize">14sp</item>
        <item name="android:letterSpacing">0.01</item>
        <item name="iconPadding">8dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="strokeColor">@color/dragon_magenta</item>
        <item name="strokeWidth">1dp</item>
        <item name="backgroundTint">@color/button_secondary_background</item>
        <item name="android:textColor">@color/button_secondary_text</item>
        <item name="rippleColor">@color/plum_mist_100</item>
    </style>
    <style name="Widget.DragonView.Button.Period" parent="Widget.Material3.Button.OutlinedButton">
        <item name="shapeAppearance">@style/ShapeAppearance.DragonView.Small</item>
        <item name="android:minHeight">@dimen/touch_target</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:paddingStart">4dp</item>
        <item name="android:paddingEnd">4dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textSize">12sp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="backgroundTint">@color/period_button_background</item>
        <item name="android:textColor">@color/period_button_text</item>
        <item name="strokeColor">@color/dragon_magenta</item>
        <item name="strokeWidth">1dp</item>
        <item name="rippleColor">@color/plum_orchid_400</item>
    </style>
    <style name="Widget.DragonView.Button.Text" parent="Widget.Material3.Button.TextButton">
        <item name="shapeAppearance">@style/ShapeAppearance.DragonView.Small</item>
        <item name="android:minHeight">@dimen/touch_target</item>
        <item name="android:minWidth">@dimen/touch_target</item>
        <item name="android:paddingStart">12dp</item>
        <item name="android:paddingEnd">12dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textSize">14sp</item>
        <item name="android:letterSpacing">0.01</item>
        <item name="iconPadding">8dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
    </style>
    <style name="Widget.DragonView.Button.Success" parent="Widget.DragonView.Button">
        <item name="backgroundTint">@color/dragon_green</item>
    </style>
    <style name="Widget.DragonView.Button.QuickAction" parent="Widget.Material3.Button.ElevatedButton">
        <item name="shapeAppearance">@style/ShapeAppearance.DragonView.Medium</item>
        <item name="android:minHeight">88dp</item>
        <item name="android:minWidth">@dimen/touch_target</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">12dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textColor">@color/ink</item>
        <item name="backgroundTint">@color/white</item>
        <item name="iconPadding">10dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
    </style>

    <style name="Widget.DragonView.Card" parent="Widget.Material3.CardView.Filled">
        <item name="cardBackgroundColor">@color/white</item>
        <item name="cardCornerRadius">16dp</item>
        <item name="cardElevation">2dp</item>
        <item name="strokeWidth">0dp</item>
    </style>

    <style name="Widget.DragonView.TextInputLayout" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="shapeAppearance">@style/ShapeAppearance.DragonView.Small</item>
        <item name="boxBackgroundColor">@color/white</item>
        <item name="boxStrokeColor">@color/dragon_outline</item>
        <item name="boxStrokeWidth">1dp</item>
        <item name="boxStrokeWidthFocused">2dp</item>
        <item name="hintTextColor">@color/muted_ink</item>
    </style>
    <style name="Widget.DragonView.TextInputLayout.Dropdown" parent="Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu">
        <item name="shapeAppearance">@style/ShapeAppearance.DragonView.Small</item>
        <item name="boxStrokeColor">@color/dragon_outline</item>
        <item name="boxStrokeWidth">1dp</item>
        <item name="boxStrokeWidthFocused">2dp</item>
    </style>
    <style name="Widget.DragonView.DialogField" parent="Widget.AppCompat.EditText">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">56dp</item>
        <item name="android:layout_marginTop">10dp</item>
        <item name="android:background">@drawable/dialog_field_background</item>
        <item name="android:paddingStart">14dp</item>
        <item name="android:paddingTop">10dp</item>
        <item name="android:paddingEnd">14dp</item>
        <item name="android:paddingBottom">10dp</item>
        <item name="android:textColor">@color/ink</item>
        <item name="android:textColorHint">@color/muted_ink</item>
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:textSize">16sp</item>
    </style>
    <style name="Widget.DragonView.DialogSpinner" parent="Widget.AppCompat.Spinner.Underlined">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">56dp</item>
        <item name="android:background">@drawable/dialog_field_background</item>
        <item name="android:paddingStart">14dp</item>
        <item name="android:paddingEnd">14dp</item>
        <item name="android:popupBackground">@color/white</item>
    </style>

    <style name="TextAppearance.DragonView.HeadlineSmall" parent="TextAppearance.Material3.HeadlineSmall">
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textColor">@color/ink</item>
        <item name="android:textSize">24sp</item>
        <item name="android:letterSpacing">-0.01</item>
    </style>
    <style name="TextAppearance.DragonView.TitleLarge" parent="TextAppearance.Material3.TitleLarge">
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textColor">@color/ink</item>
        <item name="android:textSize">20sp</item>
        <item name="android:letterSpacing">-0.01</item>
    </style>
    <style name="TextAppearance.DragonView.TitleMedium" parent="TextAppearance.Material3.TitleMedium">
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textColor">@color/ink</item>
        <item name="android:textSize">16sp</item>
        <item name="android:letterSpacing">0</item>
    </style>
    <style name="TextAppearance.DragonView.BodyLarge" parent="TextAppearance.Material3.BodyLarge">
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:textColor">@color/ink</item>
        <item name="android:textSize">16sp</item>
        <item name="android:lineSpacingExtra">4dp</item>
    </style>
    <style name="TextAppearance.DragonView.BodyMedium" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:textColor">@color/muted_ink</item>
        <item name="android:textSize">14sp</item>
        <item name="android:lineSpacingExtra">3dp</item>
    </style>
    <style name="TextAppearance.DragonView.GuidanceBody" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">5dp</item>
        <item name="android:fontFamily">serif</item>
        <item name="android:textColor">@color/ink</item>
        <item name="android:textSize">15sp</item>
        <item name="android:lineSpacingExtra">4dp</item>
    </style>
    <style name="TextAppearance.DragonView.Navigation.Active" parent="TextAppearance.Material3.LabelMedium">
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textSize">11sp</item>
        <item name="android:letterSpacing">0.02</item>
    </style>
    <style name="TextAppearance.DragonView.Navigation.Inactive" parent="TextAppearance.Material3.LabelMedium">
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:textSize">11sp</item>
        <item name="android:letterSpacing">0.02</item>
    </style>
    <style name="DashboardMetric" parent="Widget.Material3.CardView.Filled">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">116dp</item>
        <item name="android:layout_columnWeight">1</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:padding">16dp</item>
        <item name="android:background">@drawable/metric_card_background</item>
        <item name="android:textColor">@color/ink</item>
        <item name="android:textSize">22sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">-0.02</item>
    </style>
    <style name="DashboardOverviewValue" parent="TextAppearance.Material3.TitleMedium">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/dragon_magenta</item>
        <item name="android:textStyle">bold</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textSize">18sp</item>
        <item name="android:letterSpacing">-0.01</item>
    </style>
    <style name="DashboardOverviewLabel" parent="TextAppearance.Material3.BodySmall">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">2dp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textColor">@color/muted_ink</item>
    </style>
</resources>
