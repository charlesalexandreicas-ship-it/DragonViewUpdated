<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:left="2dp" android:top="3dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/neo_shadow" />
            <corners android:radius="24dp" />
        </shape>
    </item>
    <item android:right="2dp" android:bottom="3dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/neo_surface_high" />
            <stroke android:width="1dp" android:color="@color/neo_highlight" />
            <corners android:radius="22dp" />
        </shape>
    </item>
    <item android:left="2dp" android:top="2dp" android:right="2dp" android:bottom="2dp" android:gravity="left" android:width="6dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/dragon_magenta" />
            <corners android:topLeftRadius="20dp" android:bottomLeftRadius="20dp" />
        </shape>
    </item>
</layer-list>
