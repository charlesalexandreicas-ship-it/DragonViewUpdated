<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="5dp"
    android:layout_marginBottom="5dp"
    app:cardBackgroundColor="@color/white"
    app:cardCornerRadius="16dp"
    app:cardElevation="1dp"
    app:strokeColor="@color/botanical_border"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <LinearLayout
            android:id="@+id/accordionHeader"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:minHeight="66dp"
            android:orientation="horizontal"
            android:padding="12dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/recordText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/botanical_ink"
                    android:textSize="17sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/detailsText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:textColor="@color/muted_ink"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/stageText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:textColor="@color/botanical_green"
                    android:textSize="13sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <ImageView
                android:id="@+id/expandIcon"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:contentDescription="Expand farm guidance"
                android:padding="12dp"
                android:src="@android:drawable/arrow_down_float"
                app:tint="@color/botanical_ink" />
        </LinearLayout>

        <TextView android:id="@+id/compactGuidanceButton"
            android:layout_width="wrap_content" android:layout_height="48dp"
            android:layout_marginStart="12dp" android:gravity="center_vertical"
            android:clickable="true" android:focusable="true"
            android:background="?attr/selectableItemBackground"
            android:text="View guidance" android:textColor="@color/botanical_accent"
            android:textSize="13sp" />

        <LinearLayout
            android:id="@+id/expandedContent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:paddingBottom="14dp"
            android:visibility="gone">

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/botanical_border" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/sectionPhotoButton"
                style="@style/Widget.DragonView.Button.Outlined"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="56dp"
                android:layout_marginTop="16dp"
                android:text="@string/farm_section_add_photo" />

            <TextView
                android:id="@+id/stageProgressText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="Growth stages"
                android:textColor="@color/ink"
                android:textSize="14sp"
                android:textStyle="bold" />
            <LinearLayout
                android:id="@+id/stageContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/viewGuidanceButton"
                style="@style/Widget.DragonView.BotanicalAction"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="16dp"
                android:text="View guidance" />

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:gravity="center_vertical"
                android:layout_marginTop="6dp">
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/manageRecordButton"
                    style="@style/Widget.DragonView.Button.Text"
                    android:layout_width="0dp" android:layout_weight="1"
                    android:layout_height="48dp" android:layout_marginTop="6dp"
                    android:text="View record" android:textColor="@color/botanical_accent" />
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/archiveRecordButton"
                    style="@style/Widget.DragonView.Button.Text"
                    android:layout_width="wrap_content" android:layout_height="48dp"
                    android:layout_marginTop="6dp" android:layout_marginStart="12dp" android:text="Remove"
                    android:textColor="@color/dragon_error"
                    app:icon="@android:drawable/ic_menu_delete"
                    app:iconTint="@color/dragon_error" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
