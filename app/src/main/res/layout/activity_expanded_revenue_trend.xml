<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/dragon_surface"
    android:orientation="vertical"
    android:paddingStart="20dp"
    android:paddingTop="12dp"
    android:paddingEnd="20dp"
    android:paddingBottom="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">
        <com.google.android.material.button.MaterialButton
            android:id="@+id/closeChart"
            style="@style/Widget.DragonView.Button.Outlined"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:text="@string/trend_close" />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:text="@string/trend_expanded_title"
            android:textAppearance="@style/TextAppearance.DragonView.TitleLarge"
            android:textStyle="bold" />
    </LinearLayout>

    <TextView
        android:id="@+id/chartRange"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:textColor="@color/dragon_text_soft"
        android:textSize="12sp" />
    <TextView
        android:id="@+id/chartLegend"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:textColor="@color/dragon_text_soft"
        android:textSize="12sp" />
    <ph.dragonview.mobile.ui.analytics.RevenueTrendChartView
        android:id="@+id/expandedChart"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:importantForAccessibility="yes" />
</LinearLayout>
