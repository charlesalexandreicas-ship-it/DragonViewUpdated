<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    android:orientation="vertical"
    android:paddingStart="20dp"
    android:paddingTop="10dp"
    android:paddingEnd="20dp"
    android:paddingBottom="18dp">

    <View
        android:layout_width="42dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:background="@color/dragon_outline" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">
            <TextView
                android:id="@+id/stageTitleText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="serif"
                android:textColor="@color/ink"
                android:textSize="22sp"
                android:textStyle="bold" />
            <TextView
                android:id="@+id/stageTimingText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:fontFamily="serif"
                android:textColor="@color/muted_ink"
                android:textSize="14sp" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/closeButton"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Close guidance"
            android:src="@android:drawable/ic_menu_close_clear_cancel"
            app:tint="@color/muted_ink" />
    </LinearLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="false">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="12dp">

            <LinearLayout
                android:id="@+id/referenceImagePanel"
                android:layout_width="match_parent"
                android:layout_height="150dp"
                android:layout_marginTop="14dp"
                android:background="@drawable/soft_green_panel"
                android:gravity="center"
                android:orientation="vertical">
                <ImageView
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:contentDescription="Reference image pending validation"
                    android:src="@drawable/icon_streamline_plant"
                    app:tint="@color/dragon_green" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:fontFamily="serif"
                    android:text="Reference image pending validation"
                    android:textColor="@color/dragon_green"
                    android:textSize="13sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:id="@+id/overviewText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="13dp"
                android:fontFamily="serif"
                android:textColor="@color/muted_ink"
                android:textSize="14sp"
                android:lineSpacingExtra="3dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:fontFamily="serif"
                android:text="Expected appearance"
                android:textColor="@color/dragon_green"
                android:textSize="15sp"
                android:textStyle="bold" />
            <TextView android:id="@+id/expectedText" style="@style/TextAppearance.DragonView.GuidanceBody" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:fontFamily="serif"
                android:text="What to do"
                android:textColor="@color/dragon_green"
                android:textSize="15sp"
                android:textStyle="bold" />
            <TextView android:id="@+id/tasksText" style="@style/TextAppearance.DragonView.GuidanceBody" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:fontFamily="serif"
                android:text="What to record"
                android:textColor="@color/dragon_magenta_dark"
                android:textSize="15sp"
                android:textStyle="bold" />
            <TextView android:id="@+id/recordText" style="@style/TextAppearance.DragonView.GuidanceBody" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:fontFamily="serif"
                android:text="Watch for"
                android:textColor="@color/fifo_warning"
                android:textSize="15sp"
                android:textStyle="bold" />
            <TextView android:id="@+id/warningsText" style="@style/TextAppearance.DragonView.GuidanceBody" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:fontFamily="serif"
                android:text="Ready for the next stage when…"
                android:textColor="@color/dragon_green"
                android:textSize="15sp"
                android:textStyle="bold" />
            <TextView android:id="@+id/completionText" style="@style/TextAppearance.DragonView.GuidanceBody" />

            <TextView
                android:id="@+id/sourcesToggle"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="12dp"
                android:fontFamily="serif"
                android:gravity="center_vertical"
                android:text="Sources &amp; validation"
                android:textColor="@color/dragon_magenta"
                android:textSize="14sp"
                android:textStyle="bold" />

            <LinearLayout
                android:id="@+id/sourcesContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/soft_pink_panel"
                android:orientation="vertical"
                android:padding="14dp"
                android:visibility="gone">
                <TextView android:id="@+id/validationText" style="@style/TextAppearance.DragonView.GuidanceBody" />
                <TextView
                    android:id="@+id/sourceText"
                    style="@style/TextAppearance.DragonView.GuidanceBody"
                    android:layout_marginTop="8dp"
                    android:textColor="@color/dragon_magenta_dark" />
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/optionalPhotoButton"
        style="@style/Widget.DragonView.Button.Outlined"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:fontFamily="serif"
        android:text="Add optional photo"
        app:icon="@drawable/ic_camera" />
</LinearLayout>
