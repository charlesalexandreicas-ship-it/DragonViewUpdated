<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/dragon_surface"
    android:orientation="vertical"
    android:padding="20dp">
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Capture historical page"
        android:textAppearance="@style/TextAppearance.DragonView.TitleLarge"
        android:textStyle="bold" />
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="Fit the date, every size row, and any grand total inside the frame."
        android:textColor="@color/dragon_text_soft"
        android:textSize="13sp" />
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="16dp"
        android:layout_weight="1"
        android:background="@drawable/metric_card_background">
        <androidx.camera.view.PreviewView
            android:id="@+id/cameraPreview"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />
        <ImageView
            android:id="@+id/photoPreview"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="Captured paper record"
            android:scaleType="fitCenter"
            android:visibility="gone" />
        <View
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_margin="18dp"
            android:background="@drawable/historical_capture_frame"
            android:importantForAccessibility="no" />
        <ProgressBar
            android:id="@+id/progress"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_gravity="center"
            android:visibility="gone" />
    </FrameLayout>
    <TextView
        android:id="@+id/messageText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:gravity="center"
        android:text="The photo is processed on this device. Review every extracted value."
        android:textColor="@color/dragon_text_soft"
        android:textSize="12sp" />
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:orientation="horizontal">
        <com.google.android.material.button.MaterialButton
            android:id="@+id/retakeButton"
            style="@style/Widget.DragonView.Button.Outlined"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_weight="1"
            android:text="Retake"
            android:visibility="gone" />
        <com.google.android.material.button.MaterialButton
            android:id="@+id/captureButton"
            style="@style/Widget.DragonView.ModuleAction.Primary"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_weight="1"
            android:text="Capture page"
            app:icon="@drawable/ic_camera" />
        <com.google.android.material.button.MaterialButton
            android:id="@+id/usePhotoButton"
            style="@style/Widget.DragonView.ModuleAction.Primary"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:text="Use photo"
            android:visibility="gone" />
    </LinearLayout>
    <com.google.android.material.button.MaterialButton
        android:id="@+id/galleryButton"
        style="@style/Widget.DragonView.Button.Text"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="6dp"
        android:text="Choose existing photo" />
</LinearLayout>
