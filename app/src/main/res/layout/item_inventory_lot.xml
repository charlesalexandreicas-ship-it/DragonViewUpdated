<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:layout_marginTop="5dp" android:layout_marginBottom="5dp"
    app:cardBackgroundColor="@color/white" app:cardCornerRadius="16dp"
    app:cardElevation="1dp" app:strokeColor="@color/botanical_border" app:strokeWidth="1dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:padding="14dp">
        <LinearLayout android:id="@+id/batchHeader" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:minHeight="64dp"
            android:orientation="horizontal" android:gravity="center_vertical"
            android:background="?attr/selectableItemBackground" android:clickable="true"
            android:focusable="true">
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:orientation="vertical">
                <TextView android:id="@+id/batchText" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:fontFamily="monospace"
                    android:textColor="@color/botanical_ink" android:textSize="19sp"
                    android:textStyle="bold" android:maxLines="1" android:ellipsize="end" />
                <TextView android:id="@+id/compositionText" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:layout_marginTop="2dp"
                    android:textColor="@color/muted_ink" android:textSize="13sp" />
                <TextView android:id="@+id/dateText" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:layout_marginTop="2dp"
                    android:textColor="@color/muted_ink" android:textSize="13sp" />
            </LinearLayout>
            <TextView android:id="@+id/piecesText" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:layout_marginStart="6dp"
                android:textColor="@color/botanical_ink" android:textSize="18sp"
                android:textStyle="bold" android:maxLines="1" />
            <ImageView android:id="@+id/expandIcon" android:layout_width="40dp"
                android:layout_height="48dp" android:padding="13dp"
                android:contentDescription="Expand batch" android:src="@android:drawable/arrow_down_float"
                app:tint="@color/botanical_ink" />
        </LinearLayout>
        <LinearLayout android:id="@+id/expandedContent" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:orientation="vertical"
            android:visibility="gone">
            <TextView android:id="@+id/ageText" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:layout_marginTop="4dp"
                android:textColor="@color/muted_ink" android:textSize="13sp" />
            <TextView android:id="@+id/breakdownText" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:layout_marginTop="12dp"
                android:background="@color/botanical_rose" android:padding="12dp"
                android:textColor="@color/botanical_ink" android:textSize="14sp"
                android:lineSpacingExtra="5dp" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="8dp" android:text="Estimate value in details"
                android:textColor="@color/muted_ink" android:textSize="12sp" />
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="8dp" android:orientation="horizontal"
                android:gravity="center_vertical">
                <com.google.android.material.button.MaterialButton android:id="@+id/detailsButton"
                    style="@style/Widget.DragonView.Button.Text" android:layout_width="0dp"
                    android:layout_height="48dp" android:layout_weight="1"
                    android:text="View details" android:textColor="@color/botanical_accent" />
                <ImageButton android:id="@+id/archiveButton" android:layout_width="48dp"
                    android:layout_height="48dp" android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/inventory_remove_batch" android:padding="13dp"
                    android:src="@android:drawable/ic_menu_delete"
                    app:tint="@color/muted_ink" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
