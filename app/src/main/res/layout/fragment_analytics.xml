<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/dragon_surface"
    android:orientation="vertical"
    android:paddingStart="20dp"
    android:paddingTop="16dp"
    android:paddingEnd="20dp">

    <TextView
        android:id="@+id/messageText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:textColor="@color/dragon_error" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:fillViewport="true">
        <LinearLayout
            android:id="@+id/analyticsContent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="28dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/periodInput"
                    style="@style/Widget.DragonView.Button.Outlined"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:minHeight="48dp"
                    android:text="Daily"
                    android:textColor="@color/ink"
                    app:icon="@drawable/ic_analytics_dropdown"
                    app:iconGravity="textEnd"
                    app:iconSize="14dp"
                    app:iconTint="@color/ink" />
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/dateInput"
                    android:layout_marginStart="8dp"
                    style="@style/Widget.DragonView.Button.Outlined"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:minHeight="48dp"
                    android:text="Choose date"
                    android:textColor="@color/ink"
                    app:icon="@drawable/ic_analytics_dropdown"
                    app:iconGravity="textEnd"
                    app:iconSize="14dp"
                    app:iconTint="@color/ink" />
            </LinearLayout>

            <ProgressBar
                android:id="@+id/progress"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="8dp" />

            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.DragonView.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="14dp">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">
                        <ImageView
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            android:importantForAccessibility="no"
                            android:src="@drawable/icon_dataset_analytics"
                            app:tint="@color/botanical_header" />
                        <TextView
                            style="@style/AnalyticsMetricLabel"
                            android:layout_width="wrap_content"
                            android:layout_marginStart="8dp"
                            android:text="Revenue" />
                        <TextView
                            android:id="@+id/revenueText"
                            style="@style/AnalyticsMetricFigure"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:gravity="end"
                            android:maxLines="2"
                            android:textSize="24sp" />
                    </LinearLayout>
                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginVertical="10dp"
                        android:background="@color/dragon_outline" />
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:baselineAligned="false"
                        android:orientation="horizontal">
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">
                            <ImageView
                                android:layout_width="18dp"
                                android:layout_height="18dp"
                                android:importantForAccessibility="no"
                                android:src="@drawable/icon_streamline_sales"
                                app:tint="@color/botanical_header" />
                            <TextView
                                android:id="@+id/salesText"
                                style="@style/AnalyticsMetricFigure"
                                android:maxLines="2"
                                android:textSize="16sp" />
                            <TextView
                                style="@style/AnalyticsMetricLabel"
                                android:text="Completed sales"
                                android:textSize="11sp" />
                        </LinearLayout>
                        <View
                            android:layout_width="1dp"
                            android:layout_height="match_parent"
                            android:layout_marginHorizontal="6dp"
                            android:background="@color/dragon_outline" />
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">
                            <ImageView
                                android:layout_width="18dp"
                                android:layout_height="18dp"
                                android:importantForAccessibility="no"
                                android:src="@drawable/icon_streamline_inventory"
                                app:tint="@color/botanical_header" />
                            <TextView
                                android:id="@+id/piecesText"
                                style="@style/AnalyticsMetricFigure"
                                android:maxLines="2"
                                android:textSize="16sp" />
                            <TextView
                                style="@style/AnalyticsMetricLabel"
                                android:text="Pieces sold"
                                android:textSize="11sp" />
                        </LinearLayout>
                        <View
                            android:layout_width="1dp"
                            android:layout_height="match_parent"
                            android:layout_marginHorizontal="6dp"
                            android:background="@color/dragon_outline" />
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">
                            <ImageView
                                android:layout_width="18dp"
                                android:layout_height="18dp"
                                android:importantForAccessibility="no"
                                android:src="@drawable/icon_dataset_analytics"
                                app:tint="@color/botanical_header" />
                            <TextView
                                android:id="@+id/weightText"
                                style="@style/AnalyticsMetricFigure"
                                android:maxLines="2"
                                android:textSize="16sp" />
                            <TextView
                                style="@style/AnalyticsMetricLabel"
                                android:text="Weight sold"
                                android:textSize="11sp" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                app:cardBackgroundColor="@color/neo_surface_high"
                app:cardCornerRadius="20dp"
                app:cardElevation="1dp"
                app:strokeColor="@color/neo_highlight"
                app:strokeWidth="1dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="18dp">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Revenue trend" android:textAppearance="@style/TextAppearance.DragonView.TitleLarge" android:textStyle="bold" />
                    <TextView
                        android:id="@+id/trendLegendText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:textColor="@color/dragon_text_soft"
                        android:textSize="12sp" />
                    <ph.dragonview.mobile.ui.analytics.RevenueTrendChartView
                        android:id="@+id/trendChart"
                        android:layout_width="match_parent"
                        android:layout_height="280dp"
                        android:layout_marginTop="14dp"
                        android:importantForAccessibility="yes" />
                    <TextView
                        android:id="@+id/comparisonText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textColor="@color/dragon_text_soft"
                        android:textSize="12sp" />
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/comparisonCard"
                        style="@style/Widget.DragonView.Button.Outlined"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:minHeight="48dp"
                        android:text="Change comparison" />
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/expandTrendButton"
                        style="@style/Widget.DragonView.Button.Outlined"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:layout_marginTop="8dp"
                        android:enabled="false"
                        android:text="@string/trend_expand" />
                    <TextView
                        android:id="@+id/historicalHourNote"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="Date-only historical sales are included in revenue totals, not assigned to an invented hour."
                        android:textColor="@color/dragon_text_soft"
                        android:textSize="11sp"
                        android:visibility="gone" />
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/historicalMonthlyButton"
                        style="@style/Widget.DragonView.Button.Outlined"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:layout_marginTop="8dp"
                        android:text="@string/historical_view_monthly_trend"
                        android:visibility="gone" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/summaryToggle"
                style="@style/Widget.DragonView.Button.Outlined"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="22dp"
                android:contentDescription="Show sales by size and grade"
                android:text="Sales by size and grade · Show" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:id="@+id/summaryDescriptionText"
                android:text="App sales show size and grade; historical paper sales show size only because grade and weight were not recorded."
                android:textColor="@color/dragon_text_soft"
                android:textSize="12sp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/summaryEmptyText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/metric_card_background"
                android:gravity="center"
                android:minHeight="72dp"
                android:padding="16dp"
                android:text="No sold size and grade combinations for this period."
                android:textColor="@color/muted_ink"
                android:textSize="13sp"
                android:visibility="gone" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/summaryList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:nestedScrollingEnabled="false"
                android:visibility="gone" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/historicalRecordsButton"
                style="@style/Widget.DragonView.Button.Outlined"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="18dp"
                android:text="Input historical records"
                app:icon="@drawable/icon_dataset_add" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>
