<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="@dimen/space_xl">

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/scannerPreviewCard"
            android:layout_width="match_parent"
            android:layout_height="220dp"
            app:cardBackgroundColor="@color/dragon_scanner"
            app:cardCornerRadius="0dp"
            app:cardElevation="0dp"
            app:strokeColor="@color/neo_highlight"
            app:strokeWidth="0dp">
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent">
                <androidx.camera.view.PreviewView
                    android:id="@+id/cameraPreview"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="@string/scanner_preview_description" />
                <ImageView
                    android:id="@+id/selectedImagePreview"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="@string/scanner_image_description"
                    android:scaleType="fitCenter"
                    android:visibility="gone" />
                <ph.dragonview.mobile.ui.scanner.DetectionOverlayView
                    android:id="@+id/detectionOverlay"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:visibility="gone" />
                <ImageView
                    android:id="@+id/cameraPlaceholder"
                    android:layout_width="@dimen/scanner_guide_size"
                    android:layout_height="@dimen/scanner_guide_size"
                    android:layout_gravity="center"
                    android:alpha="0.72"
                    android:importantForAccessibility="no"
                    android:src="@drawable/dragonview_logo" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="top|center_horizontal"
                    android:layout_margin="@dimen/space_md"
                    android:background="@drawable/soft_green_panel"
                    android:paddingStart="12dp"
                    android:paddingTop="6dp"
                    android:paddingEnd="12dp"
                    android:paddingBottom="6dp"
                    android:id="@+id/frameGuide"
                    android:text="@string/scanner_frame_guide"
                    android:textColor="@color/ink"
                    android:textSize="10sp"
                    android:textStyle="bold" />
                <TextView
                    android:id="@+id/cameraStatusText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="bottom"
                    android:background="@color/dragon_scanner"
                    android:padding="@dimen/space_md"
                    android:gravity="center"
                    android:text="@string/scanner_camera_permission"
                    android:textColor="@color/white"
                    android:textSize="12sp" />
            </FrameLayout>
        </com.google.android.material.card.MaterialCardView>

        <LinearLayout
            android:id="@+id/scannerActions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_md"
            android:layout_marginHorizontal="@dimen/page_gutter"
            android:gravity="center"
            android:orientation="horizontal">
            <com.google.android.material.button.MaterialButton
                android:id="@+id/uploadButton"
                style="@style/Widget.DragonView.Button"
                android:layout_width="0dp"
                android:layout_height="@dimen/field_height"
                android:layout_weight="1"
                android:text="@string/scanner_upload"
                app:backgroundTint="@color/botanical_header" />
            <com.google.android.material.button.MaterialButton
                android:id="@+id/captureButton"
                style="@style/Widget.DragonView.Button"
                android:layout_width="0dp"
                android:layout_height="@dimen/field_height"
                android:layout_marginStart="@dimen/space_md"
                android:layout_weight="1"
                android:text="@string/scanner_enable_camera"
                app:icon="@drawable/ic_camera"
                app:iconTint="@color/white" />
            <com.google.android.material.button.MaterialButton
                android:id="@+id/retakeButton"
                style="@style/Widget.DragonView.Button.Outlined"
                android:layout_width="0dp"
                android:layout_height="@dimen/field_height"
                android:layout_marginStart="@dimen/space_md"
                android:layout_weight="1"
                android:text="@string/scanner_retake"
                app:icon="@drawable/ic_camera"
                android:visibility="gone" />
        </LinearLayout>

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/page_gutter"
            app:cardBackgroundColor="@color/neo_surface_high"
            app:cardCornerRadius="0dp"
            app:cardElevation="0dp"
            app:strokeColor="@color/neo_highlight"
            app:strokeWidth="0dp">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingTop="@dimen/space_sm"
                android:paddingBottom="@dimen/space_sm">
                <LinearLayout
                    android:id="@+id/fruitSummary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingHorizontal="@dimen/space_sm"
                    android:visibility="gone">
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:paddingVertical="@dimen/space_sm"
                        android:text="@string/scanner_results_heading"
                        android:textColor="@color/ink"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:accessibilityLiveRegion="polite" />
                    <LinearLayout
                        android:id="@+id/fruitResultsList"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical" />
                </LinearLayout>
                <TextView
                    android:id="@+id/resultLabelText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/scanner_awaiting_image"
                    android:accessibilityLiveRegion="polite"
                    android:textColor="@color/dragon_magenta"
                    android:textSize="18sp"
                    android:textStyle="bold" />
                <TextView
                    android:id="@+id/resultDetailsText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="@string/scanner_awaiting_detail"
                    android:textColor="@color/muted_ink"
                    android:textSize="13sp" />
                <com.google.android.material.progressindicator.LinearProgressIndicator
                    android:id="@+id/classificationProgress"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_md"
                    android:indeterminate="true"
                    android:visibility="gone" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
