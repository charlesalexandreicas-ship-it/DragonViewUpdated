<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/dragon_surface"
    android:clipToPadding="false">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/page_gutter"
        android:paddingTop="@dimen/space_lg"
        android:paddingEnd="@dimen/page_gutter"
        android:paddingBottom="@dimen/space_xl">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/scanner_title"
                    android:textAppearance="@style/TextAppearance.DragonView.TitleLarge"
                    android:textStyle="bold" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="@string/scanner_subtitle"
                    android:textColor="@color/muted_ink"
                    android:textSize="13sp" />
            </LinearLayout>
            <TextView
                android:id="@+id/modelStatusBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/soft_pink_panel"
                android:paddingStart="10dp"
                android:paddingTop="6dp"
                android:paddingEnd="10dp"
                android:paddingBottom="6dp"
                android:text="@string/scanner_model_pending"
                android:textColor="@color/dragon_magenta_dark"
                android:textSize="10sp"
                android:textStyle="bold" />
        </LinearLayout>

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_lg">
        <com.google.android.material.card.MaterialCardView
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_constraintDimensionRatio="1:1"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:cardBackgroundColor="@color/dragon_scanner"
            app:cardCornerRadius="@dimen/corner_card"
            app:cardElevation="2dp"
            app:strokeWidth="0dp">
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent">
                <androidx.camera.view.PreviewView
                    android:id="@+id/cameraPreview"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="@string/scanner_preview_description" />
                <ImageView
                    android:id="@+id/selectedImagePreview"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="@string/scanner_image_description"
                    android:scaleType="centerCrop"
                    android:visibility="gone" />
                <ImageView
                    android:id="@+id/cameraPlaceholder"
                    android:layout_width="@dimen/scanner_guide_size"
                    android:layout_height="@dimen/scanner_guide_size"
                    android:layout_gravity="center"
                    android:alpha="0.72"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_dragon_fruit" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="top|center_horizontal"
                    android:layout_margin="@dimen/space_md"
                    android:background="@drawable/soft_green_panel"
                    android:paddingStart="12dp"
                    android:paddingTop="6dp"
                    android:paddingEnd="12dp"
                    android:paddingBottom="6dp"
                    android:text="@string/scanner_frame_guide"
                    android:textColor="@color/ink"
                    android:textSize="10sp"
                    android:textStyle="bold" />
                <TextView
                    android:id="@+id/cameraStatusText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="bottom"
                    android:background="@color/dragon_scanner"
                    android:padding="@dimen/space_md"
                    android:gravity="center"
                    android:text="@string/scanner_camera_permission"
                    android:textColor="@color/white"
                    android:textSize="12sp" />
            </FrameLayout>
        </com.google.android.material.card.MaterialCardView>
        </androidx.constraintlayout.widget.ConstraintLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_md"
            android:gravity="center"
            android:orientation="horizontal">
            <com.google.android.material.button.MaterialButton
                android:id="@+id/uploadButton"
                style="@style/Widget.DragonView.Button.Outlined"
                android:layout_width="0dp"
                android:layout_height="@dimen/field_height"
                android:layout_weight="1"
                android:text="@string/scanner_upload" />
            <com.google.android.material.button.MaterialButton
                android:id="@+id/captureButton"
                style="@style/Widget.DragonView.Button"
                android:layout_width="0dp"
                android:layout_height="@dimen/field_height"
                android:layout_marginStart="@dimen/space_md"
                android:layout_weight="1"
                android:text="@string/scanner_enable_camera"
                app:icon="@drawable/ic_camera"
                app:iconTint="@color/white" />
        </LinearLayout>
        <com.google.android.material.button.MaterialButton
            android:id="@+id/retakeButton"
            style="@style/Widget.DragonView.Button.Outlined"
            android:layout_width="match_parent"
            android:layout_height="@dimen/button_height"
            android:layout_marginTop="@dimen/space_sm"
            android:text="@string/scanner_retake"
            android:visibility="gone" />

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_lg"
            app:cardBackgroundColor="@color/white"
            app:cardCornerRadius="@dimen/corner_card"
            app:cardElevation="2dp"
            app:strokeWidth="0dp">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/card_padding">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/scanner_result_title"
                    android:textAppearance="@style/TextAppearance.DragonView.TitleMedium"
                    android:textStyle="bold" />
                <TextView
                    android:id="@+id/resultLabelText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="@string/scanner_awaiting_image"
                    android:accessibilityLiveRegion="polite"
                    android:textColor="@color/dragon_magenta"
                    android:textSize="18sp"
                    android:textStyle="bold" />
                <TextView
                    android:id="@+id/resultDetailsText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="@string/scanner_awaiting_detail"
                    android:textColor="@color/muted_ink"
                    android:textSize="13sp" />
                <com.google.android.material.progressindicator.LinearProgressIndicator
                    android:id="@+id/classificationProgress"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_md"
                    android:indeterminate="true"
                    android:visibility="gone" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
