<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/stageRow"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/selectableItemBackground"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center_vertical"
    android:minHeight="52dp"
    android:orientation="horizontal">

    <FrameLayout android:layout_width="36dp" android:layout_height="match_parent">
        <LinearLayout android:layout_width="2dp" android:layout_height="match_parent"
            android:layout_gravity="center_horizontal" android:orientation="vertical">
            <View android:id="@+id/stageLineAbove" android:layout_width="match_parent"
                android:layout_height="0dp" android:layout_weight="1" android:background="@color/botanical_border" />
            <View android:id="@+id/stageLineBelow" android:layout_width="match_parent"
                android:layout_height="0dp" android:layout_weight="1" android:background="@color/botanical_border" />
        </LinearLayout>
        <TextView android:id="@+id/stageNumber" android:layout_width="30dp"
            android:layout_height="30dp" android:layout_gravity="center" android:gravity="center"
            android:fontFamily="@font/manrope_700" android:textSize="13sp" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingVertical="8dp">

        <TextView
            android:id="@+id/stageNameText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@font/manrope_500"
            android:textColor="@color/ink"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/timingText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:fontFamily="@font/manrope"
            android:textColor="@color/muted_ink"
            android:textSize="12sp" android:visibility="gone" />

        <TextView
            android:id="@+id/statusText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:fontFamily="@font/manrope_500"
            android:textColor="@color/muted_ink"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
