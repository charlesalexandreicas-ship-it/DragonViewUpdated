<?xml version="1.0" encoding="utf-8"?>
<androidx.swiperefreshlayout.widget.SwipeRefreshLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/swipeRefresh" android:layout_width="match_parent" android:layout_height="match_parent">
    <androidx.core.widget.NestedScrollView android:layout_width="match_parent" android:layout_height="match_parent"
        android:background="@color/dragon_surface" android:fillViewport="true">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:paddingStart="20dp" android:paddingTop="12dp"
            android:paddingEnd="20dp" android:paddingBottom="28dp">
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="Farm overview" android:textColor="@color/ink" android:textSize="18sp"
                android:textStyle="bold" />
            <TextView android:id="@+id/errorText" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:textColor="@color/dragon_error"
                android:visibility="gone" />
            <LinearLayout android:id="@+id/farmOverviewCards" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:orientation="vertical">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="10dp" android:orientation="horizontal">
                <LinearLayout style="@style/HomeSummaryCard" android:layout_marginEnd="6dp" android:orientation="vertical">
                    <ImageView android:layout_width="22dp" android:layout_height="22dp"
                        android:contentDescription="@null" android:src="@drawable/icon_streamline_inventory"
                        app:tint="@color/dragon_magenta" />
                    <TextView android:id="@+id/batchesValue" style="@style/HomeMetricFigure" android:text="—" />
                    <TextView style="@style/HomeMetricLabel" android:text="Available batches" />
                </LinearLayout>
                <LinearLayout style="@style/HomeSummaryCard" android:layout_marginStart="6dp" android:orientation="vertical">
                    <ImageView android:layout_width="22dp" android:layout_height="22dp"
                        android:contentDescription="@null" android:src="@drawable/icon_streamline_inventory"
                        app:tint="@color/dragon_green" />
                    <TextView android:id="@+id/inventoryValue" style="@style/HomeMetricFigure" android:text="—" />
                    <TextView style="@style/HomeMetricLabel" android:text="Available pcs" />
                </LinearLayout>
            </LinearLayout>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="10dp" android:orientation="horizontal">
                <LinearLayout style="@style/HomeSummaryCard" android:layout_marginEnd="6dp" android:orientation="vertical">
                    <ImageView android:layout_width="22dp" android:layout_height="22dp"
                        android:contentDescription="@null" android:src="@drawable/icon_streamline_sales"
                        app:tint="@color/dragon_magenta" />
                    <androidx.appcompat.widget.AppCompatTextView android:id="@+id/monthlyRevenueValue"
                        style="@style/HomeMetricFigure" android:maxLines="1" android:text="—"
                        app:autoSizeMaxTextSize="24sp" app:autoSizeMinTextSize="13sp"
                        app:autoSizeStepGranularity="1sp" app:autoSizeTextType="uniform" />
                    <TextView style="@style/HomeMetricLabel" android:text="Revenue this month" />
                </LinearLayout>
                <LinearLayout style="@style/HomeSummaryCard" android:layout_marginStart="6dp" android:orientation="vertical">
                    <ImageView android:layout_width="22dp" android:layout_height="22dp"
                        android:contentDescription="@null" android:src="@drawable/icon_dataset_planting"
                        app:tint="@color/dragon_green" />
                    <TextView android:id="@+id/plantingValue" style="@style/HomeMetricFigure" android:text="—" />
                    <TextView style="@style/HomeMetricLabel" android:text="Plant groups" />
                </LinearLayout>
            </LinearLayout>
            </LinearLayout>
            <TextView android:id="@+id/gradeOverviewToggle" android:layout_width="match_parent"
                android:layout_height="52dp" android:layout_marginTop="16dp"
                android:background="@drawable/home_metric_background" android:clickable="true"
                android:focusable="true" android:gravity="center_vertical" android:paddingHorizontal="16dp"
                android:text="View Grade Overview  ▾" android:textColor="@color/ink"
                android:textSize="15sp" android:textStyle="bold" />
            <LinearLayout android:id="@+id/gradeOverviewContent" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:layout_marginTop="4dp"
                android:background="@drawable/home_metric_background" android:orientation="vertical"
                android:padding="16dp" android:visibility="gone">
                <TextView android:id="@+id/gradeAText" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:text="Grade A  —" android:textColor="@color/ink" />
                <TextView android:id="@+id/gradeBText" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:layout_marginTop="8dp"
                    android:text="Grade B  —" android:textColor="@color/ink" />
                <TextView android:id="@+id/gradeCText" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:layout_marginTop="8dp"
                    android:text="Grade C  —" android:textColor="@color/ink" />
            </LinearLayout>
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="20dp" android:text="Quick actions" android:textColor="@color/ink"
                android:textSize="16sp" android:textStyle="bold" />
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="8dp" android:orientation="horizontal">
                <com.google.android.material.button.MaterialButton android:id="@+id/viewInventoryAction"
                    style="@style/Widget.DragonView.HomeQuickAction.Primary" android:layout_width="0dp"
                    android:layout_height="52dp" android:minHeight="52dp" android:layout_marginEnd="5dp" android:layout_weight="1"
                    android:text="View stock" android:textSize="12sp" app:icon="@drawable/icon_streamline_inventory" />
                <com.google.android.material.button.MaterialButton android:id="@+id/viewSalesAction"
                    style="@style/Widget.DragonView.HomeQuickAction.PrimaryGreen" android:layout_width="0dp"
                    android:layout_height="52dp" android:minHeight="52dp" android:layout_marginStart="5dp" android:layout_weight="1"
                    android:text="Sales" android:textSize="12sp" app:icon="@drawable/icon_streamline_sales" />
            </LinearLayout>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="8dp" android:orientation="horizontal">
                <com.google.android.material.button.MaterialButton android:id="@+id/viewAnalyticsButton"
                    style="@style/Widget.DragonView.HomeQuickAction.SoftPink" android:layout_width="0dp"
                    android:layout_height="52dp" android:minHeight="52dp" android:layout_marginEnd="5dp" android:layout_weight="1"
                    android:text="Analytics" android:textSize="12sp" app:icon="@drawable/icon_dataset_analytics" />
                <com.google.android.material.button.MaterialButton android:id="@+id/viewPlantGuidanceAction"
                    style="@style/Widget.DragonView.HomeQuickAction.SoftGreen" android:layout_width="0dp"
                    android:layout_height="52dp" android:minHeight="52dp" android:layout_marginStart="5dp" android:layout_weight="1"
                    android:text="Guidance" android:textSize="12sp" app:icon="@drawable/icon_dataset_planting" />
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</androidx.swiperefreshlayout.widget.SwipeRefreshLayout>
