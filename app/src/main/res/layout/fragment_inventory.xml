<?xml version="1.0" encoding="utf-8"?>
<androidx.swiperefreshlayout.widget.SwipeRefreshLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/swipeRefresh" android:layout_width="match_parent" android:layout_height="match_parent">
    <androidx.core.widget.NestedScrollView android:layout_width="match_parent" android:layout_height="match_parent"
        android:background="@color/botanical_canvas" android:fillViewport="true">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:paddingStart="16dp" android:paddingTop="16dp"
            android:paddingEnd="16dp" android:paddingBottom="24dp">
            <com.google.android.material.card.MaterialCardView android:id="@+id/inventoryHeader"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                app:cardBackgroundColor="@color/white" app:cardCornerRadius="16dp" app:cardElevation="0dp"
                app:strokeColor="@color/botanical_border" app:strokeWidth="1dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="vertical" android:paddingStart="14dp"
                    android:paddingEnd="14dp">
                    <TextView android:id="@+id/inventoryToggle" android:layout_width="match_parent"
                        android:layout_height="52dp" android:gravity="center_vertical" android:clickable="true"
                        android:focusable="true" android:background="?attr/selectableItemBackground"
                        android:text="View total inventory  ▾" android:textColor="@color/botanical_ink"
                        android:textSize="15sp" />
                    <TextView android:id="@+id/summaryText" android:layout_width="match_parent"
                        android:layout_height="wrap_content" android:paddingTop="4dp"
                        android:paddingBottom="12dp"
                        android:text="Loading inventory" android:textColor="@color/muted_ink"
                        android:textSize="14sp" android:visibility="gone" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
            <LinearLayout android:id="@+id/inventoryActions" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:layout_marginTop="10dp" android:orientation="horizontal">
                <com.google.android.material.button.MaterialButton android:id="@+id/recordHarvestButton"
                    style="@style/Widget.DragonView.BotanicalAction" android:layout_width="0dp"
                    android:layout_height="48dp" android:minHeight="48dp" android:layout_marginEnd="5dp" android:layout_weight="1"
                    android:text="Record harvest" android:textSize="13sp" app:icon="@drawable/icon_dataset_add"
                    app:iconGravity="start" />
                <com.google.android.material.button.MaterialButton android:id="@+id/editPricesButton"
                    style="@style/Widget.DragonView.BotanicalAction" android:layout_width="0dp"
                    android:layout_height="48dp" android:minHeight="48dp" android:layout_marginStart="5dp" android:layout_weight="1"
                    android:text="Edit prices" android:textSize="13sp" app:icon="@drawable/icon_streamline_edit_prices"
                    app:iconGravity="start" />
            </LinearLayout>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="18dp" android:orientation="horizontal">
                <TextView android:id="@+id/recentLabel" android:layout_width="0dp"
                    android:layout_height="wrap_content" android:layout_weight="1"
                    android:text="INVENTORY" android:textColor="@color/botanical_ink"
                    android:textSize="14sp" android:textStyle="bold" />
                <TextView android:id="@+id/availableCountText" android:layout_width="wrap_content"
                    android:layout_height="wrap_content" android:textColor="@color/muted_ink"
                    android:textSize="13sp" />
            </LinearLayout>
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/classFilterLayout"
                style="@style/Widget.DragonView.TextInputLayout.Dropdown"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="12dp" android:hint="Fruit class">
                <com.google.android.material.textfield.MaterialAutoCompleteTextView
                    android:id="@+id/classFilter" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:minHeight="48dp"
                    android:inputType="none" />
            </com.google.android.material.textfield.TextInputLayout>
            <LinearLayout android:id="@+id/emptyState" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:gravity="center" android:orientation="vertical"
                android:padding="28dp" android:visibility="gone">
                <TextView android:id="@+id/emptyText" android:layout_width="wrap_content"
                    android:layout_height="wrap_content" android:gravity="center" android:text="No inventory yet."
                    android:textColor="@color/muted_ink" />
                <com.google.android.material.button.MaterialButton android:id="@+id/emptyActionButton"
                    style="@style/Widget.DragonView.Button.Outlined" android:layout_width="wrap_content"
                    android:layout_height="48dp" android:layout_marginTop="12dp" android:text="Record harvest"
                    android:textColor="@color/dragon_magenta" app:icon="@drawable/icon_dataset_add"
                    app:iconTint="@color/dragon_magenta" />
            </LinearLayout>
            <androidx.recyclerview.widget.RecyclerView android:id="@+id/inventoryList"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false" android:overScrollMode="never" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</androidx.swiperefreshlayout.widget.SwipeRefreshLayout>
