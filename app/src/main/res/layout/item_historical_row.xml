<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="8dp"
    app:cardBackgroundColor="@color/white"
    app:cardCornerRadius="16dp"
    app:cardElevation="0dp"
    app:strokeColor="@color/neo_highlight"
    app:strokeWidth="1dp">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="14dp"
        android:paddingTop="8dp"
        android:paddingEnd="8dp"
        android:paddingBottom="12dp">
        <LinearLayout
            android:id="@+id/rowHeader"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal">
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">
                <TextView
                    android:id="@+id/rowTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/historical_new_size"
                    android:textColor="@color/ink"
                    android:textSize="15sp"
                    android:textStyle="bold" />
                <TextView
                    android:id="@+id/rowSummary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:maxLines="2"
                    android:textColor="@color/muted_ink"
                    android:textSize="12sp"
                    android:visibility="gone" />
            </LinearLayout>
            <com.google.android.material.button.MaterialButton
                android:id="@+id/removeButton"
                style="@style/Widget.DragonView.Button.Text"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:minWidth="64dp"
                android:text="@string/historical_remove_size"
                android:textColor="@color/dragon_error" />
            <TextView
                android:id="@+id/expandText"
                android:layout_width="32dp"
                android:layout_height="48dp"
                android:gravity="center"
                android:text="@string/historical_collapse"
                android:textColor="@color/muted_ink"
                android:textSize="18sp" />
        </LinearLayout>
        <LinearLayout
            android:id="@+id/rowFields"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">
            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.DragonView.TextInputLayout.Dropdown"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/historical_size"
                app:hintAnimationEnabled="false">
                <com.google.android.material.textfield.MaterialAutoCompleteTextView
                    android:id="@+id/sizeInput"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="none" />
            </com.google.android.material.textfield.TextInputLayout>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:baselineAligned="false"
                android:orientation="horizontal">
                <com.google.android.material.textfield.TextInputLayout
                    style="@style/Widget.DragonView.TextInputLayout"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:hint="@string/historical_weight_kg"
                    app:hintAnimationEnabled="false">
                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/weightInput"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="numberDecimal" />
                </com.google.android.material.textfield.TextInputLayout>
                <com.google.android.material.textfield.TextInputLayout
                    style="@style/Widget.DragonView.TextInputLayout"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:hint="@string/historical_price_per_kg"
                    app:hintAnimationEnabled="false">
                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/priceInput"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="numberDecimal" />
                </com.google.android.material.textfield.TextInputLayout>
            </LinearLayout>
            <TextView
                android:id="@+id/calculatedSubtotalText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="@string/historical_subtotal_empty"
                android:textColor="@color/ink"
                android:textSize="14sp"
                android:textStyle="bold" />
            <com.google.android.material.button.MaterialButton
                android:id="@+id/paperSubtotalToggle"
                style="@style/Widget.DragonView.Button.Text"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="4dp"
                android:gravity="start|center_vertical"
                android:text="@string/historical_paper_subtotal"
                android:textColor="@color/dragon_magenta" />
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/paperSubtotalLayout"
                style="@style/Widget.DragonView.TextInputLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/historical_paper_amount"
                android:visibility="gone"
                app:hintAnimationEnabled="false">
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/paperSubtotalInput"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="numberDecimal" />
            </com.google.android.material.textfield.TextInputLayout>
            <com.google.android.material.button.MaterialButton
                android:id="@+id/rowTypeToggle"
                style="@style/Widget.DragonView.Button.Text"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:gravity="start|center_vertical"
                android:text="@string/historical_change_sale_type"
                android:textColor="@color/dragon_magenta" />
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/recordTypeLayout"
                style="@style/Widget.DragonView.TextInputLayout.Dropdown"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/historical_row_sale_type"
                android:visibility="gone"
                app:hintAnimationEnabled="false">
                <com.google.android.material.textfield.MaterialAutoCompleteTextView
                    android:id="@+id/recordTypeInput"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="none" />
            </com.google.android.material.textfield.TextInputLayout>
            <TextView
                android:id="@+id/rowMismatchText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:textColor="@color/dragon_error"
                android:textSize="12sp"
                android:visibility="gone" />
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
